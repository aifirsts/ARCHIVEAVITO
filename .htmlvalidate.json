{
  "$schema": "https://html-validate.org/schemas/config.json",
  "extends": ["html-validate:recommended", "html-validate:a11y"],
  "rules": {
    "prefer-native-element": "off",
    "no-inline-style": "off",
    "long-title": "off",
    "attribute-boolean-style": "off",
    "void-style": "off",
    "no-trailing-whitespace": "off",
    "require-sri": "off",
    "wcag/h63": "off",
    "heading-level": "error",
    "no-dup-id": "error",
    "element-required-attributes": "error",
    "wcag/h37": "error"
  }
}
